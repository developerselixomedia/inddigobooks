{% comment %}
  Password Page Main Section
{% endcomment %}

<section class="section section-password text-center">
  <div class="page-width page-width--narrow">
    <div class="password-content">
      <div class="password-brand">
        <h2>{{ shop.name }}</h2>
        <p>Our grand online bookstore with over 2,000+ titles is opening soon!</p>
      </div>

      {%- if shop.password_message != blank -%}
        <div class="password-message">
          {{ shop.password_message }}
        </div>
      {%- endif -%}

      <div class="password-newsletter-box">
        <h3>Be the first to know when we launch</h3>
        {% form 'customer' %}
          <input type="hidden" name="contact[tags]" value="prospect,password-page">
          <div class="input-group">
            <input type="email" name="contact[email]" placeholder="Enter your email" required class="input-field">
            <button type="submit" class="btn btn--primary">Notify Me</button>
          </div>
        {% endform %}
      </div>

      <div class="password-login-form">
        <details>
          <summary>Store Owner Login</summary>
          {% form 'storefront_password' %}
            <div class="input-group">
              <input type="password" name="password" placeholder="Enter password" class="input-field">
              <button type="submit" class="btn btn--secondary">Enter</button>
            </div>
          {% endform %}
        </details>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Password Main",
  "settings": []
}
{% endschema %}


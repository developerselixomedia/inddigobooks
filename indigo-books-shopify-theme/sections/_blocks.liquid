{% comment %}
  Universal Blocks Renderer for Horizon Architecture
{% endcomment %}

<div class="theme-block-wrapper" id="Block-{{ section.id }}">
  {%- for block in section.blocks -%}
    <div class="theme-block theme-block--{{ block.type }}" {{ block.shopify_attributes }}>
      {%- case block.type -%}
        {%- when 'heading' -%}
          <h2 class="theme-block__heading">{{ block.settings.heading | escape }}</h2>
        {%- when 'text' -%}
          <div class="theme-block__text rte">{{ block.settings.text }}</div>
        {%- when 'button' -%}
          <a href="{{ block.settings.link }}" class="btn btn--primary">{{ block.settings.label | escape }}</a>
        {%- when 'image' -%}
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy">
          {%- endif -%}
      {%- endcase -%}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Modular Blocks",
  "settings": [],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Curated Collections" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Content", "default": "<p>Discover our handpicked selection of books.</p>" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Button Label", "default": "Explore Now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Modular Blocks"
    }
  ]
}
{% endschema %}

{% comment %}
  Layered Slideshow Section for Book Releases and Campaigns
{% endcomment %}

<section class="section section-layered-slideshow" id="LayeredSlideshow-{{ section.id }}">
  <div class="page-width">
    <div class="layered-slideshow-container">
      {%- for block in section.blocks -%}
        <div class="layered-slide {% if forloop.first %}layered-slide--active{% endif %}" {{ block.shopify_attributes }}>
          <div class="layered-slide__content">
            {%- if block.settings.subheading != blank -%}
              <span class="layered-slide__subheading">{{ block.settings.subheading }}</span>
            {%- endif -%}
            <h2 class="layered-slide__heading">{{ block.settings.heading }}</h2>
            <p class="layered-slide__text">{{ block.settings.text }}</p>
            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_link }}" class="btn btn--primary">
                {{ block.settings.button_label }} &rarr;
              </a>
            {%- endif -%}
          </div>
          <div class="layered-slide__image-wrap">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.heading | escape }}" loading="lazy">
            {%- else -%}
              <div class="layered-slide__placeholder">
                {% render 'icon', name: 'book' %}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Layered Slideshow",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Slide Image" },
        { "type": "text", "id": "subheading", "label": "Subheading", "default": "Special Book Edition" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Curated Collections For Avid Readers" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Hand-picked titles selected by literary critics and enthusiastic readers." },
        { "type": "text", "id": "button_label", "label": "Button Label", "default": "Explore Collection" },
        { "type": "url", "id": "button_link", "label": "Button Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Layered Slideshow",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}


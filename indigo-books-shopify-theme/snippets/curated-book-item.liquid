{% comment %}
  Indigo Books India - Curated Book Card Component
  Supports 2:3 book ratio, smooth hover zoom, quick view overlay button, and mini overview modal data.
{% endcomment %}

{%- capture book_json -%}
{
  "title": {{ title | json }},
  "author": {{ author | json }},
  "price": {{ price | json }},
  "originalPrice": {{ original | json }},
  "discount": {{ discount | json }},
  "stars": {{ stars | default: '5' | json }},
  "reviews": {{ reviews | default: '120' | json }},
  "cover": {{ image_name | asset_url | json }},
  "isbn": {{ isbn | default: '978-8193859214' | json }},
  "publisher": {{ publisher | default: 'Indigo Books Curations' | json }},
  "language": {{ language | default: 'Hindi / English' | json }},
  "pages": {{ pages | default: '280 pp' | json }},
  "binding": {{ binding | default: 'Paperback' | json }},
  "desc": {{ desc | json }}
}
{%- endcapture -%}

<div class="curated-book-card group flex flex-col justify-between bg-white rounded-xl border border-slate-200/90 shadow-sm hover:shadow-xl transition-all duration-300 p-3.5 relative h-full">
  <div>
    <!-- Cover Media with 2:3 aspect ratio & Hover Overlay -->
    <div
      class="curated-book-media relative aspect-[2/3] w-full rounded-lg overflow-hidden bg-slate-100 cursor-pointer shadow-inner"
      onclick="openQuickView(this.dataset.book)"
      data-book='{{ book_json | escape }}'
      title="Click for Mini Overview & Instant Order"
    >
      <img
        src="{{ image_name | asset_url }}"
        alt="{{ title | escape }}"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.onerror=null; this.src='{{ 'hero-book-dozakh.jpg' | asset_url }}';"
        loading="lazy"
        width="300"
        height="450"
      >
      
      {%- if discount != blank -%}
        <span class="absolute top-2 left-2 bg-[#D99B26] text-slate-950 font-bold text-[10px] px-2 py-0.5 rounded shadow z-10">
          {{ discount }}
        </span>
      {%- endif -%}

      <!-- Dark Hover Action Overlay with Quick View Button -->
      <div class="curated-book-overlay absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center p-3 z-20">
        <button
          type="button"
          class="curated-qv-btn bg-white hover:bg-[#D99B26] text-slate-900 hover:text-slate-950 text-xs font-bold px-3.5 py-1.5 rounded-full shadow-lg transition-all transform active:scale-95 flex items-center gap-1.5"
          onclick="event.stopPropagation(); openQuickView(this.closest('.curated-book-media').dataset.book)"
        >
          <span><i data-lucide="book-open"></i></span>
          <span>Mini Overview</span>
        </button>
      </div>
    </div>

    <!-- Metadata -->
    <div class="pt-3">
      <h3
        class="font-serif font-bold text-sm text-slate-900 line-clamp-1 group-hover:text-[#D99B26] transition-colors cursor-pointer"
        onclick="openQuickView(this.closest('.curated-book-card').querySelector('.curated-book-media').dataset.book)"
        title="{{ title | escape }}"
      >
        {{ title }}
      </h3>
      <p class="text-xs text-slate-500 mt-0.5 truncate">{{ author }}</p>

      <div class="flex items-center gap-1 text-amber-400 text-xs mt-1.5">
        <span><span class="rating-stars" style="color: #f59e0b; display: inline-flex; align-items: center; gap: 1px;"><i data-lucide="star" style="width: 13px; height: 13px; fill: #f59e0b;"></i><i data-lucide="star" style="width: 13px; height: 13px; fill: #f59e0b;"></i><i data-lucide="star" style="width: 13px; height: 13px; fill: #f59e0b;"></i><i data-lucide="star" style="width: 13px; height: 13px; fill: #f59e0b;"></i><i data-lucide="star" style="width: 13px; height: 13px; fill: #f59e0b;"></i></span></span>
        <span class="text-slate-400 text-[10px]">({{ reviews | default: '120' }})</span>
      </div>
    </div>
  </div>

  <!-- Bottom Pricing & Dual Actions -->
  <div class="mt-3 pt-2.5 border-t border-slate-100">
    <div class="flex items-baseline gap-1.5 mb-2">
      <span class="text-sm font-bold text-slate-900 font-serif price-text">{{ price }}</span>
      {%- if original != blank -%}
        <span class="text-xs text-slate-400 line-through font-serif">{{ original }}</span>
      {%- endif -%}
    </div>

    <div class="grid grid-cols-2 gap-2" style="display: grid !important; grid-template-columns: 1fr 1fr !important; gap: 8px !important; margin-top: 8px !important;">
      <button
        type="button"
        class="w-full bg-slate-100 hover:bg-amber-100 text-slate-800 hover:text-amber-900 border border-slate-200 hover:border-amber-300 py-1.5 px-2 rounded-lg text-[11px] font-bold transition-all flex items-center justify-center gap-1 cursor-pointer active:scale-95 shadow-sm"
        onclick="openQuickView(this.closest('.curated-book-card').querySelector('.curated-book-media').dataset.book)"
        title="Open Interactive Mini Overview"
      >
        <span><i data-lucide="book-open"></i></span>
        <span>Mini Overview</span>
      </button>

      <button
        type="button"
        class="w-full bg-[#D99B26] hover:bg-[#b88019] text-slate-950 font-bold py-1.5 px-2 rounded-lg text-[11px] transition-all flex items-center justify-center gap-1 cursor-pointer active:scale-95 shadow-sm"
        onclick="openQuickView(this.closest('.curated-book-card').querySelector('.curated-book-media').dataset.book)"
      >
        <span>Order</span>
        <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><path d="M19 6h-2c0-2.76-2.24-5-5-5S7 3.24 7 6H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-7-3c1.66 0 3 1.34 3 3H9c0-1.66 1.34-3 3-3zm7 17H5V8h14v12z"/></svg>
      </button>
    </div>
  </div>
</div>
        <button type="submit" style="width: 100%; background: #121212; color: #FFFFFF; border: none; border-radius: 8px; padding: 14px; font-size: 15px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 4px 14px rgba(18,18,18,0.25);">
          <span>Confirm &amp; Place Order &rarr;</span>
        </button>

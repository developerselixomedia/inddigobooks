<div class="video-block" {{ block.shopify_attributes }}>
  {%- if block.settings.video_url != blank -%}
    <iframe src="{{ block.settings.video_url }}" frameborder="0" allowfullscreen loading="lazy"></iframe>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Video",
  "settings": [
    { "type": "video_url", "id": "video_url", "accept": ["youtube", "vimeo"], "label": "Video URL" }
  ]
}
{% endschema %}

<div class="jumbo-text-block" {{ block.shopify_attributes }}>
  <h1 class="jumbo-heading">{{ block.settings.text | default: '2,000+ BOOKS' }}</h1>
</div>
{% schema %}
{
  "name": "Jumbo Text",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "2,000+ BOOKS" }
  ]
}
{% endschema %}

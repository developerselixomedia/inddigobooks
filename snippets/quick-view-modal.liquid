<style id="miniOverviewStandaloneCss">
  #miniOverviewModal {
    position: fixed !important;
    inset: 0 !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    background-color: rgba(10, 17, 40, 0.78) !important;
    backdrop-filter: blur(8px) !important;
    -webkit-backdrop-filter: blur(8px) !important;
    z-index: 999999 !important;
    display: none;
    align-items: center !important;
    justify-content: center !important;
    padding: 16px !important;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease !important;
    box-sizing: border-box !important;
  }

  #miniOverviewModal.active,
  #miniOverviewModal.is-open {
    display: flex !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  #miniOverviewBox {
    background: #FFFDF9 !important;
    border-radius: 20px !important;
    max-width: 840px !important;
    width: 100% !important;
    max-height: 92vh !important;
    overflow-y: auto !important;
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.7) !important;
    border: 2px solid rgba(180, 83, 9, 0.25) !important;
    position: relative !important;
    padding: 24px 28px !important;
    color: #0f172a !important;
    box-sizing: border-box !important;
    transform: scale(0.95);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }

  #miniOverviewModal.active #miniOverviewBox,
  #miniOverviewModal.is-open #miniOverviewBox {
    transform: scale(1) !important;
  }

  @media (max-width: 640px) {
    #miniOverviewBox {
      padding: 18px 16px !important;
      border-radius: 16px !important;
    }
  }
</style>

<!-- =========================================================================
     INTERACTIVE "MINI OVERVIEW" POP-UP INFO BOX MODAL (UNIVERSAL ACROSS ALL BOOKS)
     ========================================================================= -->
<div id="miniOverviewModal" class="fixed inset-0 bg-black/75 backdrop-blur-sm z-[99999] opacity-0 pointer-events-none transition-all duration-300 flex items-center justify-center p-3 sm:p-6" onclick="if(event.target===this) closeMiniOverview()">
  <div id="miniOverviewBox" class="bg-[#FFFDF9] rounded-2xl max-w-3xl w-full max-h-[92vh] overflow-y-auto shadow-[0_25px_60px_-15px_rgba(0,0,0,0.7)] border-2 border-amber-900/20 transform scale-95 transition-all duration-300 relative p-5 sm:p-8 text-slate-900">
    
    <!-- Top Bar with Official Badge & Close Button -->
    <div class="flex items-center justify-between pb-3 mb-4 border-b border-amber-900/10">
      <div class="inline-flex items-center gap-2 bg-amber-100 text-amber-900 border border-amber-300 px-3 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider">
        <span><i data-lucide="book-open"></i> INDIGO BOOKS • MINI OVERVIEW</span>
      </div>
      <button type="button" onclick="closeMiniOverview()" class="p-1.5 rounded-full hover:bg-amber-100 text-slate-500 hover:text-slate-900 transition-colors" aria-label="Close Pop-Up Info Box">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-start">
      
      <!-- Left Column: Book Cover Media & Badges -->
      <div class="sm:col-span-5 flex flex-col items-center">
        <div class="aspect-[2/3] w-48 sm:w-full rounded-r-md rounded-l-sm overflow-hidden shadow-[0_15px_30px_rgba(0,0,0,0.5)] border-r-4 border-amber-100 bg-slate-100 relative group">
          <img id="moCover" src="assets/hero-book-dozakh.jpg" alt="Book Cover" class="w-full h-full object-cover">
          <div class="absolute inset-y-0 left-0 w-3 bg-gradient-to-r from-black/60 to-transparent"></div>
          <span id="moDiscountBadge" class="absolute top-2.5 right-2.5 bg-rose-600 text-white font-extrabold text-[11px] px-2 py-0.5 rounded shadow">
            25% OFF
          </span>
        </div>

        <!-- Verified Stock & Fast Delivery Badge -->
        <div class="mt-4 w-full bg-emerald-50 border border-emerald-200 rounded-xl p-3 text-center">
          <div class="flex items-center justify-center gap-1.5 text-xs font-bold text-emerald-800">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>In Stock at Prayagraj Warehouse</span>
          </div>
          <div class="text-[11px] text-emerald-700 mt-0.5">Express Dispatch Across India</div>
        </div>

        <!-- Indian Pincode Delivery Checker -->
        <div class="mt-3 w-full bg-slate-50 border border-slate-200 rounded-xl p-3">
          <label class="block text-[11px] font-bold text-slate-700 mb-1">Check Pincode Delivery:</label>
          <div class="flex gap-1.5">
            <input type="text" id="moPincodeInput" maxlength="6" placeholder="e.g. 211001" class="text-xs px-2.5 py-1.5 rounded-lg border border-slate-300 w-full focus:outline-none focus:border-[#D99B26] bg-white">
            <button type="button" onclick="checkMoPincode()" class="bg-[#0A1128] hover:bg-[#D99B26] text-white font-bold text-xs px-3 py-1.5 rounded-lg transition-colors whitespace-nowrap">
              Check
            </button>
          </div>
          <div id="moPincodeResult" class="text-[11px] mt-1 font-semibold hidden"></div>
        </div>
      </div>

      <!-- Right Column: Metadata, 3 Highlights, Specs & Excerpt -->
      <div class="sm:col-span-7 flex flex-col justify-between space-y-4">
        <div>
          <!-- Category & Star Rating -->
          <div class="flex items-center justify-between">
            <span id="moCategoryBadge" class="text-[10px] uppercase font-bold text-amber-800 bg-amber-100 border border-amber-300 px-2 py-0.5 rounded">
              Hindi Sahitya
            </span>
            <div class="flex items-center gap-1 text-amber-500 text-xs font-bold">
              <span><span class="rating-stars" style="color: #f59e0b; display: inline-flex; align-items: center; gap: 1px;"><i data-lucide="star" style="width: 13px; height: 13px; fill: #f59e0b;"></i><i data-lucide="star" style="width: 13px; height: 13px; fill: #f59e0b;"></i><i data-lucide="star" style="width: 13px; height: 13px; fill: #f59e0b;"></i><i data-lucide="star" style="width: 13px; height: 13px; fill: #f59e0b;"></i><i data-lucide="star" style="width: 13px; height: 13px; fill: #f59e0b;"></i></span></span>
              <span id="moReviews" class="text-slate-500 text-[11px] font-normal">(540+ verified readers)</span>
            </div>
          </div>

          <!-- Book Title & Author -->
          <h2 id="moTitle" class="font-serif font-bold text-2xl sm:text-3xl text-[#0A1128] mt-2 leading-tight">
            Book Title
          </h2>
          <p id="moAuthor" class="text-sm font-semibold text-slate-600 mt-0.5">
            By Celebrated Author • Publisher
          </p>

          <!-- Price Row (Clean Geometric Bold Numerals) -->
          <div class="mt-3 py-2 px-3 bg-amber-50/60 rounded-xl border border-amber-200/60 flex items-baseline gap-3">
            <span id="moPrice" class="text-2xl sm:text-3xl font-extrabold text-[#0A1128]">₹299.00</span>
            <span id="moMrp" class="text-sm text-slate-400 line-through">₹395.00</span>
            <span id="moSave" class="text-xs font-bold text-emerald-700 bg-emerald-100 border border-emerald-300 px-2 py-0.5 rounded ml-auto">
              Save ₹96 (24% OFF)
            </span>
          </div>

          <!-- 3-Bullet Key Highlights -->
          <div class="mt-4 p-4 bg-white rounded-xl border border-amber-900/10 shadow-sm space-y-2">
            <div class="text-[11px] uppercase font-extrabold text-amber-900 tracking-wider">
              • Curated Overview & Significance:
            </div>
            <ul class="space-y-1.5 text-xs text-slate-700">
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5"><i data-lucide="bookmark"></i></span>
                <div><strong>What it's about:</strong> <span id="moAbout">Haunting narrative exploring human dignity, aristocratic heritage, and Uttar Pradesh history.</span></div>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5"><i data-lucide="landmark"></i></span>
                <div><strong>Literary significance:</strong> <span id="moSignificance">Recipient of national literary laurels and praised across universities.</span></div>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5"><i data-lucide="target"></i></span>
                <div><strong>Target reader:</strong> <span id="moReader">Lovers of progressive Indian prose, students of literature, and discerning readers.</span></div>
              </li>
            </ul>
          </div>

          <!-- Specifications Grid -->
          <div class="mt-3 grid grid-cols-2 gap-2 text-xs text-slate-700 bg-slate-50 p-3 rounded-xl border border-slate-200">
            <div><span class="text-slate-400">Pages:</span> <strong id="moPages" class="text-slate-900">248 Pages</strong></div>
            <div><span class="text-slate-400">Binding:</span> <strong id="moBinding" class="text-slate-900">Paperback</strong></div>
            <div><span class="text-slate-400">Language:</span> <strong id="moLanguage" class="text-slate-900">Hindi</strong></div>
            <div><span class="text-slate-400">Publisher:</span> <strong id="moPublisher" class="text-slate-900">Rajkamal Prakashan</strong></div>
            <div class="col-span-2"><span class="text-slate-400">ISBN / Barcode:</span> <strong id="moIsbn" class="text-slate-900 font-mono">978-8126731023</strong></div>
          </div>

          <!-- Collapsible "Read First Page Excerpt" -->
          <div class="mt-3">
            <button type="button" onclick="toggleMoExcerpt()" class="w-full text-left py-2 px-3 rounded-xl bg-amber-100/70 hover:bg-amber-100 text-amber-950 font-bold text-xs flex items-center justify-between transition-colors border border-amber-300">
              <span><i data-lucide="book-open"></i> Read First Page Opening Excerpt</span>
              <span id="moExcerptArrow">▾</span>
            </button>
            <div id="moExcerptBox" class="hidden mt-2 p-3 bg-amber-50 rounded-xl border border-amber-200 text-xs italic font-serif text-slate-800 leading-relaxed max-h-36 overflow-y-auto">
              <span id="moExcerptText">"हवेली के ऊंचे दालानों में चीलों की छाया जब ढलती धूप के साथ फैलती, तो ऐसा लगता मानो समय वहीं ठहर गया हो..."</span>
            </div>
          </div>
        </div>

        <!-- Action Row (Add to Cart + WhatsApp COD) -->
        <div class="mt-5 pt-4 border-t border-slate-200 flex flex-col sm:flex-row gap-3">
          <button id="moAddToCartBtn" type="button" onclick="addCurrentMoBookToCart()" class="flex-1 bg-[#0A1128] hover:bg-[#D99B26] text-white font-bold py-3 px-4 rounded-xl text-sm transition-all shadow-md flex items-center justify-center gap-2 active:scale-95">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 6h-2c0-2.76-2.24-5-5-5S7 3.24 7 6H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-7-3c1.66 0 3 1.34 3 3H9c0-1.66 1.34-3 3-3zm7 17H5V8h14v12z"/></svg>
            <span>Add to Cart</span>
          </button>
          
          <a id="moWhatsAppBtn" href="#" target="_blank" class="flex-1 bg-[#10B981] hover:bg-[#059669] text-white font-bold py-3 px-4 rounded-xl text-sm transition-all shadow-md flex items-center justify-center gap-2 active:scale-95 text-center">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z"/></svg>
            <span>WhatsApp COD Order</span>
          </a>
        </div>

      </div>

    </div>

  </div>
</div>
{% comment %}
  Predictive Search Live Results Section
{% endcomment %}

{%- if predictive_search.performed -%}
  <div id="predictive-search-results" class="predictive-search-dropdown-content">
    {%- if predictive_search.resources.products.size > 0 -%}
      <div class="predictive-search-group">
        <h4 class="predictive-search-heading">Books Matching "{{ predictive_search.terms }}"</h4>
        <ul class="predictive-search-list">
          {%- for product in predictive_search.resources.products -%}
            <li class="predictive-search-item">
              <a href="{{ product.url }}" class="predictive-search-link">
                {%- if product.featured_media -%}
                  <img src="{{ product.featured_media | image_url: width: 80 }}" alt="{{ product.title | escape }}" class="predictive-thumb" loading="lazy">
                {%- else -%}
                  <div class="predictive-thumb-placeholder">{% render 'icon', name: 'book' %}</div>
                {%- endif -%}
                <div class="predictive-info">
                  <span class="predictive-title">{{ product.title | escape }}</span>
                  <span class="predictive-author">by {{ product.vendor | default: 'Author' }}</span>
                  <span class="predictive-price">{{ product.price | money }}</span>
                </div>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>

      <div class="predictive-search-footer">
        <button type="submit" form="HeaderSearchForm" class="btn btn--primary btn--full-width btn--sm">
          View all results for "{{ predictive_search.terms }}" &rarr;
        </button>
      </div>
    {%- else -%}
      {% render 'predictive-search-empty' %}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Predictive Search",
  "settings": []
}
{% endschema %}


    {%- if section.settings.title != blank -%}
      <div class="text-center mb-8">
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-900 tracking-tight uppercase">
          {{ section.settings.title | escape }}
        </h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="text-xs sm:text-sm text-slate-500 mt-1.5 max-w-2xl mx-auto">
            {{ section.settings.subtitle | escape }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign collection = collections[section.settings.collection] -%}
    {%- if collection != blank and collection.products_count > 0 -%}
      <div class="product-list-grid grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <div class="h-full">
            {% render 'product-card', product: product, section_id: section.id %}
          </div>
        {%- endfor -%}
      </div>

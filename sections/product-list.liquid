{% schema %}
{
  "name": "Product List",
  "settings": [
    { "type": "checkbox", "id": "bg_cream", "label": "Warm Cream Background (Indigo Classic)", "default": false },
    { "type": "text", "id": "title", "label": "Heading", "default": "Staff Picks & Editor Choices" },
    { "type": "text", "id": "subtitle", "label": "Subheading", "default": "Hand-selected by our in-house bibliophiles" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 12, "step": 1, "default": 6, "label": "Products to show" }
  ],
  "presets": [
    { "name": "Product List" }
  ]
}
{% endschema %}



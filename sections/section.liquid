{% comment %}
  Universal Layout Section for Horizon Theme
{% endcomment %}

<section class="section section--{{ section.id }} {{ section.settings.custom_class }}" id="Section-{{ section.id }}">
  <div class="{% if section.settings.full_width %}page-width--full{% else %}page-width{% endif %}">
    {%- for block in section.blocks -%}
      <div class="section-block section-block--{{ block.type }}" {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2 class="section-block__heading">{{ block.settings.title | escape }}</h2>
          {%- when 'text' -%}
            <div class="section-block__text rte">{{ block.settings.text }}</div>
          {%- when 'button' -%}
            <a href="{{ block.settings.link }}" class="btn btn--primary">{{ block.settings.label | escape }}</a>
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "General Section",
  "settings": [
    { "type": "checkbox", "id": "full_width", "label": "Full Width", "default": false },
    { "type": "text", "id": "custom_class", "label": "Custom CSS Class" }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Featured Spotlight" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Content", "default": "<p>Discover literary masterpieces curated for your bookshelf.</p>" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Button Label", "default": "Shop Now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "General Section"
    }
  ]
}
{% endschema %}


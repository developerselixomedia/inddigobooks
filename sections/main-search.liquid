{% comment %}
  Indigo Books India - Dedicated High-Conversion Search Results Template
  Fully styled with 4-Column Responsive Grid matching Catalog
  Official WhatsApp Concierge: +91 8933063306
{% endcomment %}

<section class="section section-main-search" style="background: #FAF8F5; min-height: 80vh; padding: 32px 0 64px;">
  <div class="site-container" style="max-width: 1320px; margin: 0 auto; padding: 0 28px; box-sizing: border-box;">
    
    <!-- Top Breadcrumb Bar -->
    <div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 0 20px; border-bottom: 1px solid #E2E8F0; margin-bottom: 28px; font-size: 13px; color: #64748B; flex-wrap: wrap; gap: 12px;">
      <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
        <a href="/" style="color: #0066B3; text-decoration: none; font-weight: 600;">Home</a>
        <span style="color: #94A3B8; font-size: 12px;">&rsaquo;</span>
        <span style="color: #0F172A; font-weight: 600;">Search Results: "{{ search.terms | escape }}"</span>
      </div>
      <a href="/" style="display: inline-flex; align-items: center; gap: 6px; background: #FFFFFF; color: #0F172A; border: 1px solid #CBD5E1; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; text-decoration: none;">
        <i data-lucide="arrow-left" style="width: 15px; height: 15px;"></i> Back to Bookstore
      </a>
    </div>

    <!-- Editorial Search Header & Search Box -->
    <div style="text-align: center; max-width: 720px; margin: 0 auto 36px;">
      <div style="font-size: 11px; font-weight: 800; color: #B45309; text-transform: uppercase; letter-spacing: 0.14em; margin-bottom: 6px;">
        PAN-INDIA ARCHIVE SEARCH
      </div>
      <h1 style="font-family: 'Merriweather', Georgia, serif; font-size: 32px; font-weight: 700; color: #0F172A; margin: 0 0 16px;">
        Search 5,500+ Indian Books
      </h1>
      <form action="{{ routes.search_url }}" method="get" role="search" style="display: flex; align-items: center; background: #FFFFFF; border: 1px solid #CBD5E1; border-radius: 10px; padding: 6px 8px 6px 16px; box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06); gap: 10px;">
        <i data-lucide="search" style="width: 18px; height: 18px; color: #94A3B8; flex-shrink: 0;"></i>
        <input
          type="text"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="Search title, author, ISBN..."
          style="flex: 1; border: none; outline: none; font-size: 14px; color: #0F172A; background: transparent; padding: 8px 0;"
          required
        >
        <input type="hidden" name="type" value="product">
        <button type="submit" style="background: #0066B3; color: #FFFFFF; border: none; border-radius: 8px; padding: 10px 20px; font-size: 13.5px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
          Search
        </button>
      </form>
      
      {%- if search.performed -%}
        <div style="margin-top: 14px; font-size: 13.5px; color: #64748B;">
          {%- if search.results_count > 0 -%}
            Found <strong style="color: #0F172A;">{{ search.results_count }}</strong> book{% if search.results_count != 1 %}s{% endif %} matching "<strong>{{ search.terms | escape }}</strong>"
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Search Results Section -->
    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        {%- paginate search.results by 24 -%}
          <div class="catalog-cards-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-bottom: 40px;">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {%- assign product = item -%}
                {%- assign current_variant = product.selected_or_first_available_variant -%}
                <div class="catalog-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 12px; padding: 18px; display: flex; flex-direction: column; transition: transform 0.2s, box-shadow 0.2s;">
                  <a href="{{ product.url }}" style="text-decoration: none; color: inherit; display: block;">
                    <div class="catalog-thumb" style="width: 100%; aspect-ratio: 2 / 3; background: #F8FAFC; border-radius: 6px; overflow: hidden; margin-bottom: 12px; position: relative;">
                      {%- if product.featured_image -%}
                        <img
                          src="{{ product.featured_image | image_url: width: 600 }}"
                          alt="{{ product.title | escape }}"
                          loading="lazy"
                          style="width: 100%; height: 100%; object-fit: cover; display: block;"
                        >
                      {%- else -%}
                        <img
                          src="{{ 'hero-godan.jpg' | asset_url }}"
                          alt="{{ product.title | escape }}"
                          loading="lazy"
                          style="width: 100%; height: 100%; object-fit: cover; display: block;"
                        >
                      {%- endif -%}
                    </div>
                  </a>

                  <div style="font-size: 10.5px; font-weight: 700; color: #B45309; text-transform: uppercase; margin-bottom: 4px;">
                    {%- if product.compare_at_price > product.price -%}
                      {{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}% OFF
                    {%- else -%}
                      IN STOCK
                    {%- endif -%}
                  </div>

                  <h3 style="font-family: 'Merriweather', Georgia, serif; font-size: 15px; font-weight: 700; color: #0F172A; line-height: 1.3; margin: 0 0 4px; min-height: 38px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                    <a href="{{ product.url }}" style="color: inherit; text-decoration: none;">{{ product.title | escape }}</a>
                  </h3>

                  <div style="font-size: 12px; color: #64748B; margin-bottom: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    {{ product.vendor | default: 'Indigo Books India' }}
                  </div>

                  <div style="display: flex; align-items: baseline; gap: 8px; margin-top: auto; margin-bottom: 14px;">
                    <span style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 18px; font-weight: 800; color: #0F172A; font-variant-numeric: lining-nums tabular-nums !important;">
                      {{ product.price | money }}
                    </span>
                    {%- if product.compare_at_price > product.price -%}
                      <span style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 12px; text-decoration: line-through; color: #94A3B8; font-variant-numeric: lining-nums tabular-nums !important;">
                        {{ product.compare_at_price | money }}
                      </span>
                    {%- endif -%}
                  </div>

                  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                    <a href="{{ product.url }}" class="btn-overview" style="display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 9px 12px; background: #F1F5F9; color: #0F172A; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 12.5px; font-weight: 700; text-decoration: none; cursor: pointer;">
                      <i data-lucide="book-open" style="width: 14px; height: 14px;"></i> Details
                    </a>
                    <button type="button" class="btn-add-cart" onclick="addToCart('{{ product.id }}', '{{ current_variant.id }}')" style="display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 9px 12px; background: #0066B3; color: #FFFFFF; border: none; border-radius: 6px; font-size: 12.5px; font-weight: 700; cursor: pointer;">
                      <i data-lucide="shopping-bag" style="width: 14px; height: 14px;"></i> Add
                    </button>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <div style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 32px;">
              {{ paginate | default_pagination }}
            </div>
          {%- endif -%}
        {%- endpaginate -%}

      {%- else -%}
        <!-- Empty State with WhatsApp Concierge -->
        <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 16px; padding: 48px 32px; text-align: center; max-width: 680px; margin: 0 auto; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);">
          <div style="width: 64px; height: 64px; border-radius: 50%; background: #FEF3C7; color: #B45309; display: flex; align-items: center; justify-content: center; margin: 0 auto 18px;">
            <i data-lucide="search-x" style="width: 32px; height: 32px;"></i>
          </div>
          <h2 style="font-family: 'Merriweather', Georgia, serif; font-size: 24px; font-weight: 700; color: #0F172A; margin: 0 0 10px;">
            No Books Found for "{{ search.terms | escape }}"
          </h2>
          <p style="font-size: 14px; color: #64748B; line-height: 1.6; margin: 0 0 28px;">
            We couldn't find an exact match for your search query. Check for spelling errors, try searching by author name (e.g., <em>Premchand</em>, <em>Shrilal Shukla</em>, <em>Javed Akhtar</em>), or let our literary desk source it for you.
          </p>

          <!-- WhatsApp Concierge Card -->
          <div style="background: #FFFBEB; border: 1px solid #FDE68A; border-radius: 12px; padding: 22px; text-align: left; margin-bottom: 28px;">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
              <i data-lucide="message-circle" style="width: 20px; height: 20px; color: #16A34A;"></i>
              <strong style="font-size: 15px; color: #92400E;">Can't find your book? We will source it!</strong>
            </div>
            <p style="font-size: 13px; color: #78350F; line-height: 1.5; margin: 0 0 14px;">
              Our Prayagraj bookstore maintains direct partnerships with Vani, Rajkamal, Rekhta, Radhakrishna, and legal publishers across India. We source out-of-print, regional, and university books.
            </p>
            <a href="https://wa.me/918933063306?text=Hi%20Indigo%20Books,%20I%20am%20looking%20for%20this%20book:%20{{ search.terms | url_encode }}." target="_blank" style="display: inline-flex; align-items: center; gap: 8px; background: #25D366; color: #FFFFFF; padding: 10px 18px; border-radius: 8px; font-size: 13px; font-weight: 700; text-decoration: none;">
              <i data-lucide="message-circle" style="width: 16px; height: 16px;"></i> Ask Book Concierge on WhatsApp (+91 8933063306) &rarr;
            </a>
          </div>

          <!-- Quick Navigation Links -->
          <div>
            <div style="font-size: 12px; font-weight: 700; color: #64748B; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 12px;">
              Or Explore Popular Collections
            </div>
            <div style="display: flex; justify-content: center; gap: 10px; flex-wrap: wrap;">
              <a href="/#shop-all-catalog" style="background: #F1F5F9; color: #0F172A; padding: 8px 14px; border-radius: 6px; font-size: 12.5px; font-weight: 600; text-decoration: none;">All Books (5,500+)</a>
              <a href="/#bestsellers-podium" style="background: #F1F5F9; color: #0F172A; padding: 8px 14px; border-radius: 6px; font-size: 12.5px; font-weight: 600; text-decoration: none;">Top Bestsellers</a>
              <a href="/#mehfil-rekhta" style="background: #F1F5F9; color: #0F172A; padding: 8px 14px; border-radius: 6px; font-size: 12.5px; font-weight: 600; text-decoration: none;">Rekhta &amp; Urdu Poetry</a>
              <a href="/#law-academic-vault" style="background: #F1F5F9; color: #0F172A; padding: 8px 14px; border-radius: 6px; font-size: 12.5px; font-weight: 600; text-decoration: none;">Law &amp; Academic Vault</a>
            </div>
          </div>

        </div>
      {%- endif -%}
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Main Search Results",
  "tag": "section",
  "class": "indigo-main-search-section",
  "settings": [],
  "presets": [
    {
      "name": "Main Search Results"
    }
  ]
}
{% endschema %}

